# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=

# OpenAI
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_EXTRACTION_MODEL=gpt-4o-mini

# Google Sheets: paste the service-account JSON on one line, or base64-encode it
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_RANGE=Leads!A:J

# Optional: only accept messages from this Telegram chat ID
ALLOWED_TELEGRAM_CHAT_ID=

# Webhook mode only
PORT=3000
PUBLIC_URL=
TELEGRAM_WEBHOOK_SECRET=
